# ============================================================
# Edge AI for Smart Bank Transfers
# .gitignore
# ============================================================
#
# Policy:
# - Keep source code, configuration, datasets, reports and
#   evaluation results in GitHub.
# - Do NOT push heavy trained-model artifacts to GitHub.
# - Download the ignored model artifacts from EC2 to the local PC
#   before terminating the EC2 instance.
# ============================================================


# ------------------------------------------------------------
# TRAINING / LoRA ARTIFACTS
# ------------------------------------------------------------
# Contains training checkpoints, final_adapter and tokenizer/model
# files produced by LoRA fine-tuning.

models/lfm2_700m_gptplus_lora/
models/lfm2_700m_claude_lora/


# ------------------------------------------------------------
# MERGED HUGGING FACE MODELS
# ------------------------------------------------------------
# Full models produced after merging the LoRA adapters with
# the LFM2-700M base model.

models/lfm2_700m_gptplus_merged/
models/lfm2_700m_claude_merged/


# ------------------------------------------------------------
# GGUF MODEL FILES
# ------------------------------------------------------------
# Heavy F16 and quantized GGUF files are downloaded to the PC.
# JSON conversion reports in models/gguf/ remain trackable.

models/gguf/*.gguf


# ------------------------------------------------------------
# SAFETY: LARGE MODEL / CHECKPOINT FILE TYPES
# ------------------------------------------------------------
# Prevent accidental commits if model artifacts are generated
# outside the expected directories.

*.safetensors
pytorch_model*.bin
*.gguf
*.pt
*.pth
*.ckpt


# ------------------------------------------------------------
# PYTHON CACHE / LOCAL ENVIRONMENTS
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
env/
ENV/


# ------------------------------------------------------------
# LOCAL TOOL / IDE FILES
# ------------------------------------------------------------

.vscode/
.idea/
.DS_Store
Thumbs.db


# ------------------------------------------------------------
# SECRETS / CREDENTIALS
# ------------------------------------------------------------

.env
.env.*
*.pem
*.key


# ------------------------------------------------------------
# TEMPORARY FILES / LOGS
# ------------------------------------------------------------

*.log
*.tmp
*.temp
*.swp
*~
