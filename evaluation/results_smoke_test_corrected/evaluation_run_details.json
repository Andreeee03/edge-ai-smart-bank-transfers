      "bertscore": {
        "enabled": false,
        "model": null,
        "value": "F1",
        "rescale_with_baseline": null,
        "hash": null
      },
      "normalized_exact_match": {
        "normalization": "Unicode NFKC, lowercase, punctuation removal, whitespace collapse.",
        "two_reference_strategy": "Maximum one-to-one exact matches divided by 2."
      },
      "structured_consistency": {
        "automatic_checks": [
          "currency contradiction",
          "currency-qualified amount contradiction",
          "temporal contradiction (month/year/quarter/installment)"
        ],
        "important_limitation": "This is a conservative structured check, not a complete semantic hallucination detector; qualitative review remains necessary."
      }
    },
