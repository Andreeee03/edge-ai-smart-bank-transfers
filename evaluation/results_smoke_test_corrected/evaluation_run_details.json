      "decoding": "greedy",
      "do_sample": false,
      "num_beams": 1,
      "max_new_tokens": 64,
      "batch_size": 1,
      "padding": false,
      "truncation": false,
      "prompt_boundary": "prompt.rstrip(\"\\r\\n\") + \"\\n\\n\"",
